# ── LLM Provider (Ollama Local Offline) ────────────────────────────
LLM_PROVIDER="ollama"

# Offline Local LLM (Ollama) Settings
# Use http://localhost:11434 for local dev, or http://host.docker.internal:11434 inside Docker
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# ── Task Routing Overrides (Optional) ───────────────
# ASSESSMENT_MODEL="qwen2.5:7b"
# RAG_MODEL="qwen2.5:7b"
# STRATEGY_MODEL="qwen2.5:7b"

# ── Cloud SQL / PostgreSQL Database ─────────────────
# Required for persistent assessment storage.
# When running via Docker Compose, SQL_HOST should be "db" (the service name).
# For local dev without Docker, use "localhost".
SQL_HOST="db"
SQL_USER="postgres"
SQL_PASSWORD="your_password_here"
SQL_DB_NAME="productive_point"
# Optional Admin overrides for Drizzle migrations (defaults to SQL_USER / SQL_PASSWORD)
# SQL_ADMIN_USER="postgres"
# SQL_ADMIN_PASSWORD="your_password_here"

# ── Application URL ─────────────────────────────────
APP_URL="MY_APP_URL"

# ── RAGAS Evaluation (Optional) ─────────────────────
# Required only if running eval/evaluate.py with real RAGAS scoring.
# OPENAI_API_KEY="sk-..."
